SERVICE_NAME=billing-wallet-service
SERVICE_ENV=development
LOG_LEVEL=info

POSTGRES_URL=postgres://billing_service_user:your_billing_service_password@localhost:5432/gridx_db?sslmode=disable

DOCKER_POSTGRES_URL=postgres://billing_service_user:your_billing_service_password@postgres:5432/gridx_db?sslmode=disable

REDIS_ADDRESS=localhost:6379

GRPC_ADDRESS=:50051
HEALTH_ADDRESS=:8080

METRICS_ADDRESS=:9090

# Tracing is off unless an OTLP/gRPC collector is configured.
# OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_EXPORTER_OTLP_INSECURE=true